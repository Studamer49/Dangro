# ============================================================================
# DANGRO CLIENT — Vite build-time configuration
# ============================================================================
# Copy to `client/.env` for local development.
#
# !!! EVERY `VITE_*` VALUE IS PUBLIC !!!
# Vite inlines them into the JavaScript that ships to the browser. Never put
# JWT secrets, database URLs or any other server secret in this file.

# Base URL for REST calls. "/api" is relative, which is what you want:
#   - dev:   Vite proxies /api -> http://localhost:3001 (see vite.config.ts)
#   - prod:  the same Render service serves /api on its own origin
VITE_API_URL=/api

# Socket.IO server URL.
#   - leave EMPTY for same-origin (correct for the single-service deploy)
#   - set http://localhost:3001 only when running the API on another host
VITE_WS_URL=

# ============================================================================
# TURN relay — needed for calls to connect on some networks
# ============================================================================
# Two people behind NAT can usually find a direct path using the public STUN
# servers, but not always. Mobile data and many corporate networks use
# "symmetric NAT", where no direct path exists and media MUST be relayed. In
# that case the call connects to nothing: you see only your own camera and
# nobody is audible.
#
# The app falls back to free public relays, which are rate-limited and blocked
# on some networks. Point these at your own relay for reliable calls — a free
# tier from Cloudflare, Metered or Twilio is enough to start.
#
# Comma-separate multiple URLs; `?transport=tcp` on 443 helps when UDP is
# firewalled (corporate networks often block it).
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Shorthand for a single relay (used when VITE_TURN_URLS is empty).
VITE_TURN_URL=
