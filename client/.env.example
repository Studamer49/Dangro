# ============================================================================
# DANGRO CLIENT — Vite build-time configuration
# ============================================================================
# Copy to `client/.env` for local development.
#
# !!! EVERY `VITE_*` VALUE IS PUBLIC !!!
# Vite inlines them into the JavaScript that ships to the browser. Never put
# JWT secrets, database URLs or any other server secret in this file.

# Base URL for REST calls. "/api" is relative, which is what you want:
#   - dev:   Vite proxies /api -> http://localhost:3001 (see vite.config.ts)
#   - prod:  the same Render service serves /api on its own origin
VITE_API_URL=/api

# Socket.IO server URL.
#   - leave EMPTY for same-origin (correct for the single-service deploy)
#   - set http://localhost:3001 only when running the API on another host
VITE_WS_URL=
