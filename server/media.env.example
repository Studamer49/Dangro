# ============================================================================
# DANGRO MEDIA SERVICE — local configuration
# ============================================================================
# Copy this file to `~/.dangro-media.env` on the machine that stores the
# actual image and video bytes, then fill it in. It is read only by
# `npm run media:start`, never by the API.
#
# `scripts/setup-media-env.sh` generates this file with a random key for you.
#
# Each variable MUST be on its own line — dotenv-style parsing reads one
# assignment per line.

# Shared secret the API presents as the `x-media-key` header on uploads.
# This is the only thing protecting write access to your disk, so use a long
# random value (48 bytes / 64 characters is what the script generates).
# It MUST match MEDIA_INGEST_KEY on the API host.
MEDIA_KEY=""

# Directory that holds the uploaded files. Back this up — nothing else
# replicates it, and it is the only copy.
MEDIA_DIR=./media

# Port the service listens on. Funnel exposes this to the internet on 443.
MEDIA_PORT=8081