# ============================================================================
# DANGRO SERVER — local development
# ============================================================================
# Copy this file to `server/.env` (which is git-ignored) and fill it in.
# On Render these files do not exist: set the same names under
# Dashboard -> Environment. Values marked [PUBLIC] may be shared with the
# browser; every other value is a server-side secret.
#
# Each variable MUST be on its own line — dotenv parses one per line, so
# putting two on the same line silently breaks both.

# ---------------------------------------------------------------------------
# Which database backs the server: "postgres" (default) or "mongo".
# ---------------------------------------------------------------------------
# postgres -> Prisma + PostgreSQL/Neon, requires DATABASE_URL below.
# mongo    -> MongoDB, requires MONGODB_URI below and ignores DATABASE_URL.
DATABASE_PROVIDER=postgres

# Required when DATABASE_PROVIDER=postgres. Your Neon PostgreSQL
# connection string.
# Local:    the Neon dev branch or a local Postgres instance.
# Render:   paste the Neon pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dangro?sslmode=require"

# Required when DATABASE_PROVIDER=mongo.
# Local:    a local mongod, e.g. mongodb://127.0.0.1:27017
# Atlas:    mongodb+srv://USER:PASSWORD@cluster.mongodb.net
# Images and videos are stored in GridFS inside this database.
MONGODB_URI="mongodb://127.0.0.1:27017"

# Optional. Database name inside MongoDB. Defaults to "dangro".
MONGODB_DB_NAME=dangro

# ---------------------------------------------------------------------------
# Where uploaded images and videos are stored.
#   gridfs  GridFS inside MongoDB (default when DATABASE_PROVIDER=mongo)
#   disk    server/uploads, served by express.static (default for postgres)
#   remote  a separate media host; the API 302-redirects to it
#
# PREFER gridfs/disk. Both serve media from this app's own origin, so the
# browser never makes a cross-origin request and nothing is exposed to your
# LAN. "remote" sends every image to another host, which on a home network
# makes Chrome ask the visitor to "see devices on your local network".
# See MEDIA.md.
# ---------------------------------------------------------------------------

# Optional. Absolute https:// address of a separate media host. Only used when
# MEDIA_PROVIDER=remote, and the server REFUSES TO START if this is not a
# public https origin — loopback, RFC 1918, .local and plain http are all
# rejected, because a browser cannot load those from a public page.
# MEDIA_PUBLIC_URL="https://host.your-tailnet.ts.net"

# Where the API pushes uploads. Defaults to MEDIA_PUBLIC_URL.
# MEDIA_INGEST_URL="https://host.your-tailnet.ts.net"

# Required when MEDIA_PROVIDER=remote. Must match MEDIA_KEY on the media
# host. This is the only thing guarding write access to your disk.
# Generate with: openssl rand -base64 48
# MEDIA_INGEST_KEY=""

# ---------------------------------------------------------------------------
# Cloudinary — image storage, optimisation and delivery.
#
# Images are uploaded from the backend and served from
# https://res.cloudinary.com/<CLOUD_NAME>/... The browser only ever talks to
# this API, so no local-network permission is needed to view an image.
#
# All three are required before ANY image upload will work. If they are
# missing, an image upload fails with 503 SERVICE_UNAVAILABLE and names them —
# it is never silently written to disk or GridFS instead. The server also says
# so at startup:
#   [startup] Image uploads are DISABLED — Cloudinary is not configured (...)
# and GET /api/health reports "imageStorage": "unconfigured".
#
# All three are SERVER-ONLY. Never give any of them a VITE_ prefix: that would
# inline the secret into the browser bundle.
# ---------------------------------------------------------------------------
# Cloudinary dashboard -> Settings -> Account -> API Keys.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ALTERNATIVE: Cloudinary's own single-variable form, which the dashboard's
# "copy" button produces. Accepted when the three above are not set:
# CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"
# The three separate variables always win, so adding this can never override
# a deliberately configured value. Do not set both.

# Optional. Maximum size for a single image. Default 8 MB (the limit is
# clamped to 50 MB, matching the general media ceiling).
# CLOUDINARY_IMAGE_MAX_BYTES=8388608

# Optional. Folder inside the Cloudinary media library. Default "dangro/images".
# CLOUDINARY_FOLDER="dangro/images"

# Optional. Abort an upload that has not completed within this many ms.
# CLOUDINARY_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# TURN relay — makes calls connect across different networks.
#
# Two phones on the same Wi-Fi can often find each other directly, but once a
# caller is behind a different carrier, city, or country, a NAT or a strict
# firewall can block the direct path. A TURN server relays the media when that
# happens, which is what makes calling between different locations reliable.
#
# Without TURN configured, calls still work wherever the peers can reach each
# other directly (same LAN, many home networks). Set these to add a relay.
#
# The client fetches credentials from GET /api/turn (authenticated), so the
# secret below is never in the browser bundle.
#
# TURN_URLS is a comma-separated list. A coturn server usually exposes both
# the plain and the TLS scheme; the TLS one (turns:) works through restrictive
# firewalls, so include it when you have it.
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
#
# PREFERRED — coturn's REST API "static-auth-secret". When set, the server
# mints short-lived, per-user credentials signed with this secret, so no
# long-lived password ever reaches a client:
# TURN_SECRET="the-static-auth-secret-from-turnserver.conf"
#
# ALTERNATIVE — one shared username/password for every client. Simpler, but
# the pair is handed to all users, so treat it as public:
# TURN_USERNAME="dangro"
# TURN_CREDENTIAL="a-long-random-password"
#
# Optional. Lifetime of generated credentials, in seconds. Default 3600,
# clamped to 60..86400.
# TURN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Media service settings — only used on the machine that stores the files
# (see MEDIA.md). Ignored by the API.
# ---------------------------------------------------------------------------
# MEDIA_DIR=./media
# MEDIA_PORT=8081
# MEDIA_KEY=""

# ---------------------------------------------------------------------------
# Email — verification, password reset and address-change confirmations.
#
# All of these are SERVER-ONLY. Never give any of them a VITE_ prefix: Vite
# inlines those into the browser bundle, which would publish your SMTP
# password. (There is a test that fails the build if you do.)
#
# Until these are set the app still STARTS — a missing mail server must not
# take chat down — but signup, "resend link" and "forgot password" return 503
# and name what is missing, and no account is created. You will see this on
# every boot:
#   [startup] Email is DISABLED — signup, resend and password reset will
#             return 503 (missing SMTP_HOST, EMAIL_FROM).
# and GET /api/health reports "emailDelivery": "unconfigured".
#
# Full setup, provider choices and troubleshooting: EMAIL.md
# ---------------------------------------------------------------------------

# Your mail provider. Resend: smtp.resend.com / 465 / user "resend".
# Brevo: smtp-relay.brevo.com / 587. Gmail: smtp.gmail.com / 587 (needs an
# App Password, not the account password).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587

# The login your provider issued. Omit BOTH of these for an unauthenticated
# local relay (Mailpit, MailHog); setting only one is refused at boot.
# SMTP_USER="your-provider-username"
# SMTP_PASS="your-provider-password-or-api-key"

# Optional. Forces implicit TLS on any port; defaults to true on 465 and
# false everywhere else (587 upgrades via STARTTLS).
# SMTP_SECURE=false

# The address mail is sent from. Defaults to SMTP_USER, which is right for
# nearly every provider. Must be on a domain you have VERIFIED with your
# provider, or nothing is delivered. Format "Dangro <no-reply@yourdomain.com>".
# EMAIL_FROM="Dangro <no-reply@yourdomain.com>"

# Optional. Display name for the From header when EMAIL_FROM has none.
# EMAIL_FROM_NAME="Dangro"

# The public origin every emailed link is built from. Defaults to the first
# CLIENT_URL, which is correct for both the single-origin Render deploy and
# the Vite dev server on :5173 — but set it explicitly in production, because
# a link pointing at localhost works for exactly one person.
# Must be an absolute http(s) URL; anything else is refused at boot.
# APP_BASE_URL="http://localhost:5173"

# Optional. "json" records in the server log that a message was produced
# instead of sending it — for working on the UI with no mail account. The
# message body is NOT logged, so the verification token never reaches a log.
# Leave unset (or "smtp") for anything real.
# EMAIL_TRANSPORT=json

# Optional. Hard deadline for a single send, in ms. Default 10000.
# EMAIL_TIMEOUT_MS=10000

# Optional. Link lifetimes, in minutes. Both clamped to 5-1440; the email
# states the real number, so what the user reads and what is enforced agree.
# EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Optional. Requests per IP per 15 minutes for the token endpoints. The resend
# budget is the tighter of the two: those endpoints can otherwise be used to
# mail-bomb somebody else's inbox.
# EMAIL_VERIFY_RATE_LIMIT=20
# EMAIL_RESEND_RATE_LIMIT=5

# Required. Signs access tokens. Use 32+ random characters
# (`openssl rand -base64 48`). Rotate to invalidate every session.
JWT_SECRET="replace-with-a-long-random-string"

# Required in practice. Signs refresh tokens; must differ from JWT_SECRET.
# If omitted, the server derives it from JWT_SECRET (dev convenience only).
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# The port Express listens on. Render sets this automatically — do not
# hardcode it there.
PORT=3001

# "development" | "production" | "test".
# Render sets "production". Tests set "test".
NODE_ENV=development

# Comma-separated list of browser origins allowed by CORS and Socket.IO.
# Local:  http://localhost:5173
# Render: https://<your-service>.onrender.com  (same origin as the app)
CLIENT_URL="http://localhost:5173"
