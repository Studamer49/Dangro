# ============================================================================
# DANGRO — repository-root environment (optional)
# ============================================================================
#
# The server reads `server/.env` first and falls back to this file.
# The client reads `client/.env` (Vite only loads `.env` from its own root).
#
# You normally do NOT need this file: keep values in `server/.env` and
# `client/.env` instead. It exists as a fallback and as documentation of
# every variable the project understands.
#
# NEVER commit a real `.env` file. Only `.env.example` files are tracked.
# All `VITE_*` values are PUBLIC — they are baked into the browser bundle.
# All other values are SERVER-ONLY secrets and must never be exposed to Vite.

# --- Server (server/src/config.ts) -----------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dangro?sslmode=require"
JWT_SECRET="generate-a-long-random-string"
JWT_REFRESH_SECRET="generate-a-different-long-random-string"
PORT=3001
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# --- Cloudinary (images only, server-side) --------------------------------
# Without these, every image upload fails with 503. See server/.env.example
# for the full list of optional variables.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# --- Email (verification + password reset, server-side) -------------------
# Without these the app still boots, but signup, "resend link" and "forgot
# password" return 503 and name what is missing — no account is created, so
# nobody is stranded by a missing variable. See EMAIL.md.
# All SERVER-ONLY: never give any of these a VITE_ prefix.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-provider-username"
# SMTP_PASS="your-provider-password-or-api-key"
# EMAIL_FROM="Dangro <no-reply@yourdomain.com>"
# EMAIL_FROM_NAME="Dangro"
# APP_BASE_URL="https://your-app.example.com"

# --- Client (client/vite.config.ts) ----------------------------------------
# Leave both blank for a production build served by the API on the same origin.
VITE_API_URL=/api
VITE_WS_URL=
